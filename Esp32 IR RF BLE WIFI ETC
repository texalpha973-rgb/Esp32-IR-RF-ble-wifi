void setup() {
  pinMode(BTN_UP, INPUT_PULLUP);
  pinMode(BTN_DOWN, INPUT_PULLUP);
  pinMode(BTN_SEL, INPUT_PULLUP);
  pinMode(BATTERY_PIN, INPUT);

  Wire.begin();
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);

  playBootAnimation();
  checkPinLock();

  irsend.begin();
  loadFromNVS();
  lastActivity = millis();
}

void loop() {
  if (millis() - lastActivity > AUTO_SLEEP_TIMEOUT) {
    display.clearDisplay();
    display.display();
    while (digitalRead(BTN_UP) == HIGH && digitalRead(BTN_DOWN) == HIGH && digitalRead(BTN_SEL) == HIGH) {
      yield();
    }
    lastActivity = millis();
    lastBtn = millis(); 
    redraw = true;
    return;
  }

  if (redraw) {
    showHeader("MAIN MENU");
    const char* menuItems[] = {
      "1. CAPTURE IR", "2. SAVED CODES", "3. TV SWEEP",
      "4. AC KILLER", "5. TV ROULETTE", "6. SIGNAL FUZZER",
      "7. LOGIC INVERTER", "8. WEB CONTROL", "9. SIGNAL ANALYZER",
      "10. FREQ JAMMER", "11. HEX KEYPAD", "12. BRUTE-FORCE",
      "13. RF CAPTURE", "14. RF REPLAY", "15. WIFI BEACON",
      "16. BLE SPAMMER"
    };

    int startIdx = (menuIndex >= 3) ? menuIndex - 2 : 0;
    for (int i = 0; i < 3; i++) {
      int itemIdx = startIdx + i;
      if (itemIdx >= TOTAL_MENU_ITEMS) break;
      int yPos = 20 + (i * 13);
      if (itemIdx == menuIndex) {
        display.fillRect(4, yPos - 1, 120, 12, SSD1306_WHITE);
        display.setTextColor(SSD1306_BLACK);
        display.setCursor(8, yPos);
        display.print(">"); display.print(menuItems[itemIdx]);
      } else {
        display.setTextColor(SSD1306_WHITE);
        display.setCursor(8, yPos);
        display.print(" "); display.print(menuItems[itemIdx]);
      }
    }
    display.display();
    redraw = false;
  }

  if (btnPressed(BTN_UP)) { menuIndex = (menuIndex - 1 + TOTAL_MENU_ITEMS) % TOTAL_MENU_ITEMS; redraw = true; }
  if (btnPressed(BTN_DOWN)) { menuIndex = (menuIndex + 1) % TOTAL_MENU_ITEMS; redraw = true; }

  if (btnPressed(BTN_SEL)) {
