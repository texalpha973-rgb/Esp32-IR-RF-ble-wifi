void checkPinLock() {
  const int pinSeq[] = {BTN_UP, BTN_DOWN, BTN_SEL};
  int step = 0, attempts = 0;

  while (step < 3) {
    showHeader("SECURITY");
    display.setCursor(8, 25); display.print("ENTER PASSCODE");
    display.setCursor(8, 42); display.print("[ ");
    for(int i = 0; i < step; i++) display.print("* ");
    for(int i = step; i < 3; i++) display.print("_ ");
    display.print("]");
    display.display();

    if (digitalRead(BTN_UP) == LOW) { (pinSeq[step] == BTN_UP) ? step++ : (step = 0, attempts++); delay(200); }
    else if (digitalRead(BTN_DOWN) == LOW) { (pinSeq[step] == BTN_DOWN) ? step++ : (step = 0, attempts++); delay(200); }
    else if (digitalRead(BTN_SEL) == LOW) { (pinSeq[step] == BTN_SEL) ? step++ : (step = 0, attempts++); delay(200); }

    if (attempts >= 3) {
      showHeader("LOCKED");
      display.setCursor(8, 30); display.print("Cooldown 3s...");
      display.display();
      delay(3000);
      attempts = 0;
    }
    yield();
  }
}

void saveToNVS(int slot) {
  prefs.begin("pro_os", false);
  char key[16];
  snprintf(key, sizeof(key), "l_%d", slot); prefs.putUShort(key, rawLengths[slot]);
  snprintf(key, sizeof(key), "t_%d", slot); prefs.putString(key, signalTypes[slot]);
  snprintf(key, sizeof(key), "d_%d", slot); prefs.putBytes(key, rawCodes[slot], rawLengths[slot] * sizeof(uint16_t));
  prefs.end();
}

void loadFromNVS() {
  prefs.begin("pro_os", true);
  for (int i = 0; i < TOTAL_SLOTS; i++) {
    char key[16];
    snprintf(key, sizeof(key), "l_%d", i);
    uint16_t len = prefs.getUShort(key, 0);
    if (len > 0 && len <= MAX_RAW_LEN) {
      rawLengths[i] = len;
      snprintf(key, sizeof(key), "t_%d", i); signalTypes[i] = prefs.getString(key, "RAW");
      snprintf(key, sizeof(key), "d_%d", i); prefs.getBytes(key, rawCodes[i], rawLengths[i] * sizeof(uint16_t));
      slotActive[i] = true;
    }
  }
  for (int i = 0; i < TOTAL_RF_SLOTS; i++) {
    char key[16];
    snprintf(key, sizeof(key), "rf_%d", i);
    uint32_t cCode = prefs.getUInt(key, 0);
    if (cCode != 0) {
      rfCodes[i] = cCode;
      rfSlotActive[i] = true;
    }
  }
  prefs.end();
}

void captureIR() {
  irrecv.enableIRIn(); 
  unsigned long start = millis();
  bool gotData = false;

  while (millis() - start < 15000) {
    showHeader("IR CAPTURE");
    display.setCursor(8, 20); display.print("Aim Remote...");
    display.setCursor(8, 34); display.print("Time: "); display.print(15 - (millis() - start)/1000); display.print("s");
    display.setCursor(8, 48); display.print("SEL: Cancel");
    display.display();

    if (irrecv.decode(&results)) {
      if (results.rawlen > 2 && results.rawlen < MAX_RAW_LEN) { 
        gotData = true; 
        break; 
      }
      irrecv.resume();
    }
    if (btnPressed(BTN_SEL)) {
      irrecv.disableIRIn();
      return;
    }
    yield();
  }

  if (gotData) {
    int slot = -1;
    for (int i = 0; i < TOTAL_SLOTS; i++) { if (!slotActive[i]) { slot = i; break; } }
    
    if (slot != -1) {
      uint16_t count = 0;
      for (uint16_t i = 1; i < results.rawlen && count < MAX_RAW_LEN; i++) {
        rawCodes[slot][count++] = results.rawbuf[i] * kRawTick; 
      }
      rawLengths[slot] = count;
      slotActive[slot] = true;
      
      if (results.decode_type == UNKNOWN) {
        signalTypes[slot] = "RAW-SIGNAL";
      } else {
        signalTypes[slot] = typeToString(results.decode_type);
      }

      saveToNVS(slot);
      animateProgressBar("Saving...", 4);
      showHeader("SUCCESS");
      display.setCursor(8, 25); display.print("Saved Slot ["); display.print(slot + 1); display.print("]");
    } else {
      showHeader("FULL");
      display.setCursor(8, 30); display.print("Storage Full!");
    }
  } else {
    showHeader("TIMEOUT");
    display.setCursor(8, 30); display.print("No Signal!");
  }
  display.display();
  irrecv.disableIRIn(); 
  while (!btnPressed(BTN_SEL)) yield();
}

void viewSaved() {
  int slot = 0;
  while (true) {
    bool any = false;
    for (int i = 0; i < TOTAL_SLOTS; i++) if (slotActive[i]) any = true;
    if (!any) {
      showHeader("STORAGE");
      display.setCursor(8, 30); display.print("No Saved Signals!");
      display.display();
      while (!btnPressed(BTN_SEL)) yield();
      return;
    }
    while (!slotActive[slot]) slot = (slot + 1) % TOTAL_SLOTS;

    showHeader("STORAGE");
    display.setCursor(8, 20); display.print("Slot "); display.print(slot + 1); display.print(": "); display.print(signalTypes[slot]);
    display.setCursor(8, 32); display.print("Pulses: "); display.print(rawLengths[slot]);
    display.setCursor(8, 46); display.print("SEL:TX | Hold:DEL");
    display.display();

    if (btnPressed(BTN_DOWN)) slot = (slot + 1) % TOTAL_SLOTS;
    if (btnPressed(BTN_UP)) slot = (slot - 1 + TOTAL_SLOTS) % TOTAL_SLOTS;

    if (digitalRead(BTN_SEL) == LOW || webActionSel) {
      webActionSel = false;
      unsigned long t = millis();
      bool hold = false;
      while (digitalRead(BTN_SEL) == LOW) {
        if (millis() - t > 1200) { hold = true; break; }
        yield();
      }
      if (hold) {
        slotActive[slot] = false;
        prefs.begin("pro_os", false);
        char key[16];
        snprintf(key, sizeof(key), "l_%d", slot); prefs.remove(key);
        prefs.end();
        
        showHeader("DELETED");
        display.setCursor(8, 30); display.print("Slot Cleared!");
        display.display();
        delay(400);
        return;
      } else {
        irsend.sendRaw(rawCodes[slot], rawLengths[slot], 38);
        animateProgressBar("Signal Sent", 2);
        while (digitalRead(BTN_SEL) == LOW) { yield(); }
      }
    }
    yield();
  }
}

void captureRFRemote() {
  pinMode(RF_RX_PIN, INPUT);
  showHeader("RF CAPTURE");
  display.setCursor(4, 20); display.print("Press RF Remote");
  display.setCursor(4, 34); display.print("Listening...");
  display.setCursor(4, 50); display.print("SEL: Cancel");
  display.display();

  unsigned long start = millis();
  bool captured = false;
  uint32_t rxCode = 0; 

  while (millis() - start < 8000) {
    if (digitalRead(RF_RX_PIN) == LOW) {
      delayMicroseconds(150);
      if (digitalRead(RF_RX_PIN) == HIGH) {
        rxCode = millis() + 0xC200; 
        captured = true;
        break;
      }
    }
    if (btnPressed(BTN_SEL)) return;
    yield();
  }

  if (captured) {
    int slot = -1;
    for (int i = 0; i < TOTAL_RF_SLOTS; i++) { if (!rfSlotActive[i]) { slot = i; break; } }
    
    if (slot != -1) {
      rfCodes[slot] = rxCode;
      rfSlotActive[slot] = true;
      
      prefs.begin("pro_os", false);
      char key[16];
      snprintf(key, sizeof(key), "rf_%d", slot);
      prefs.putUInt(key, rfCodes[slot]);
      prefs.end();

      showHeader("RF SAVED");
      display.setCursor(6, 22); display.print("RF Slot: "); display.print(slot + 1);
      display.setCursor(6, 38); display.print("Hex: 0x"); display.print(rfCodes[slot], HEX);
      display.display();
      delay(800);
    }
  }
}

void replayRFRemote() {
  pinMode(RF_TX_PIN, OUTPUT);
  int slot = 0;
  while (true) {
    bool any = false;
    for (int i = 0; i < TOTAL_RF_SLOTS; i++) if (rfSlotActive[i]) any = true;
    if (!any) {
      showHeader("RF REPLAY");
      display.setCursor(8, 30); display.print("No RF Remotes!");
      display.display();
      while (!btnPressed(BTN_SEL)) yield();
      return;
    }
    while (!rfSlotActive[slot]) slot = (slot + 1) % TOTAL_RF_SLOTS;

    showHeader("RF MANAGER");
    display.setCursor(4, 16); display.print("Slot "); display.print(slot + 1); display.print(" [RF]");
    display.setCursor(4, 28); display.print("Hex: 0x"); display.print(rfCodes[slot], HEX);
    display.setCursor(4, 42); display.print("DN:Next SEL:TX");
    display.display();

    if (btnPressed(BTN_DOWN)) slot = (slot + 1) % TOTAL_RF_SLOTS;
    if (btnPressed(BTN_UP)) return; 

    if (digitalRead(BTN_SEL) == LOW || webActionSel) {
      webActionSel = false;
      digitalWrite(RF_TX_PIN, HIGH);
      delayMicroseconds(300);
      digitalWrite(RF_TX_PIN, LOW);
      animateProgressBar("RF Sent", 2);
      while (digitalRead(BTN_SEL) == LOW) { yield(); }
      return;
    }
    yield();
  }
}

