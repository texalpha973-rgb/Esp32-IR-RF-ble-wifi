int getBatteryPercentage() {
  int sensorValue = analogRead(BATTERY_PIN);
  float voltage = sensorValue * (3.3 / 4095.0) * 2.0;
  int percentage = (int)((voltage - 3.3) / (4.2 - 3.3) * 100);
  if (percentage > 100) return 100;
  if (percentage < 0) return 0;
  return percentage;
}

bool btnPressed(int pin) {
  if (digitalRead(pin) == LOW || webActionUp || webActionDown || webActionSel) {
    if (webActionUp) { webActionUp = false; lastActivity = millis(); return true; }
    if (webActionDown) { webActionDown = false; lastActivity = millis(); return true; }
    if (webActionSel) { webActionSel = false; lastActivity = millis(); return true; }

    if (millis() - lastBtn > 200) {
      lastBtn = millis();
      lastActivity = millis();
      return true;
    }
  }
  return false;
}

